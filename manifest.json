{
  "manifest_version": 3,
  "name": "Crate: Record Player for Discogs",
  "version": "1.0.0",
  "description": "Play any release straight from Discogs Explore. One queue, one player at the bottom, signed in to YouTube.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "offscreen",
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "https://*.discogs.com/*",
    "https://api.discogs.com/*",
    "https://www.youtube.com/*",
    "https://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.discogs.com/*",
        "https://discogs.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/page.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/watch*"
      ],
      "js": [
        "src/yt-tab.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/bar.css"
      ],
      "matches": [
        "https://www.discogs.com/*",
        "https://discogs.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Crate",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
